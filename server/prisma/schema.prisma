generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  photoUrl  String?
  createdAt DateTime @default(now())

  bookings Booking[]
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String   @default("General")
  duration    Int
  price       Float
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())

  bookings Booking[]
}


model WorkingHours {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int      @unique
  startTime String
  endTime   String
  isOpen    Boolean  @default(true)
}


model Booking {
  id          Int           @id @default(autoincrement())
  customerId  Int?
  serviceId   Int
  barberId    Int?
  date        DateTime
  startTime   String
  endTime     String
  status      BookingStatus @default(CONFIRMED)
  totalPrice  Float
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  otp         String
  cancelledBy String?
  createdAt   DateTime      @default(now())

  customer User?   @relation(fields: [customerId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])
  barber   Barber? @relation(fields: [barberId], references: [id])
}

model Barber {
  id         Int      @id @default(autoincrement())
  name       String
  title      String
  experience String
  rating     Float    @default(5.0)
  photoUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  bookings Booking[]
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  category  String
  caption   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}


enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}


enum Role {
  CUSTOMER
  ADMIN
}